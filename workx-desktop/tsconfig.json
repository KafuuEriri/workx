{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@protocol/*": ["../workx-rs/app-server-protocol/schema/typescript/*"]
    },
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "forge.config.ts", "forge.env.d.ts", "vite.main.config.ts", "vite.preload.config.ts", "vite.renderer.config.mts"]
}
